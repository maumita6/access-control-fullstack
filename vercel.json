{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "access-control-ng21/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/access-control-ng21/browser",
        "buildCommand": "cd access-control-ng21 && npm install && npm run build",
        "developmentCommand": "cd access-control-ng21 && npm run start"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "access-control-ng21/$1",
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "access-control-ng21/index.html"
    }
  ]
}
