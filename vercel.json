{
  "version": 2,
  "buildCommand": "cd access-control-ng21 && npm install && npm run build",
  "outputDirectory": "access-control-ng21/dist/browser",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js",
	  "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}