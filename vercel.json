{
  "version": 2,
  "buildCommand": "cd access-control-ng21 && npm run build",
  "outputDirectory": "access-control-ng21/dist/access-control-ng21/browser",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}