{
  "version": 2,
  "builds": [
    { "src": "backend/server.js", "use": "@vercel/node" },
    { 
	"src": "access-control-ng21/package.json", 
	"use": "@vercel/static-build", 
	"config": { 
	"distDir": "dist/access-control-ng21" 
		} 
	}
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/server.js" },
    { "src": "/(.*)", "dest": "access-control-ng21/$1" }
  ]
}
